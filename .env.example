NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Public contact links displayed across the website.
NEXT_PUBLIC_CONTACT_PHONE=+63 9XX XXX XXXX
NEXT_PUBLIC_CONTACT_EMAIL=inquiries@example.com
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page
NEXT_PUBLIC_MESSENGER_URL=https://m.me/your-page

# Public browser key. Restrict it to your domains and the Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-embed-key

# Spam protection. Configure both values together in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
INQUIRY_RATE_LIMIT_SALT=replace-with-a-long-random-string

# Optional email notification workflow. Leads are saved without these values.
RESEND_API_KEY=your-resend-api-key
INQUIRY_NOTIFICATION_EMAIL=leads@example.com
INQUIRY_FROM_EMAIL="DGR Realty <inquiries@example.com>"
